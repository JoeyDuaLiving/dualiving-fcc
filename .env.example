# Copy to .env.local (already gitignored) and fill in real values.
# Never commit real credentials.

# --- Database (Neon Postgres) -----------------------------------------------
# Get these by linking the project with the Neon CLI (`neon link`, then
# `neon checkout <branch>`), which writes both automatically - or from the
# Neon console: Project -> Connect. DATABASE_URL is the pooled connection
# (use for the app); DATABASE_URL_UNPOOLED is direct (use for drizzle-kit
# migrations only - see drizzle.config.ts and
# .agents/skills/neon-postgres/SKILL.md for why pooled connections break
# migrations).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Buildxact -------------------------------------------------------------
# Confirmed live (Aug 2026) against https://api-v3.buildxact.com - see
# src/integrations/buildxact/config.ts for the full incident/verification
# notes. Get your Subscription Key from developer.buildxact.com -> Profile
# (only appears once your subscription is approved), and your API Key from
# https://app.buildxact.com/account/api/keys (My Business > API > API Keys).
BUILDXACT_ENVIRONMENT=production
BUILDXACT_SUBSCRIPTION_KEY=
BUILDXACT_LOGIN_EMAIL=
BUILDXACT_API_KEY=

# Optional overrides - defaults to the confirmed real values if unset.
# BUILDXACT_API_BASE_URL=https://api-v3.buildxact.com
# BUILDXACT_TOKEN_URL=https://api-v3.buildxact.com/accounts/auth/login

# Only needed for franchise/multi-tenant accounts scoping login to a
# specific tenant other than the one your user account belongs to.
# BUILDXACT_TENANT_ID=

# Shared secret configured when registering a webhook endpoint in Buildxact.
# Used to verify the signature on incoming webhook POSTs.
BUILDXACT_WEBHOOK_SECRET=

# --- Xero --------------------------------------------------------------
# Real OAuth 2.0 consent flow (not an API key) - see
# src/integrations/xero/config.ts for the confirmed endpoint reference.
# Register an app at https://developer.xero.com/myapps/ with grant type
# "Auth Code" (a Web app), and set its redirect URI to exactly match
# XERO_REDIRECT_URI below. Tokens themselves are stored in the database
# (integration_connections table) once connected via Settings, not in env
# vars - they rotate on every refresh.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Must exactly match the redirect URI configured in the Xero app. Xero
# allows http://localhost for testing (not http://127.0.0.1).
XERO_REDIRECT_URI=http://localhost:3000/api/integrations/xero/callback

# --- GoHighLevel (GHL) -------------------------------------------------
# Private Integration Token (PIT) - a static bearer token, not OAuth (that's
# only needed for a Marketplace app installed on accounts you don't own).
# Generate one in the GHL account: Settings > Private Integrations > Create
# new Integration. Scope it to at least: opportunities.readonly,
# contacts.readonly. GHL_LOCATION_ID is the sub-account id (visible in
# Settings > Business Info, or the URL while viewing the sub-account).
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=

# --- Anthropic (Claude API) --------------------------------------------
# Used by the What If chat (src/app/api/what-if-chat/route.ts) to turn a
# free-text scenario into a structured adjustment via tool use, then narrate
# the computed result - the model never does the cash-flow arithmetic
# itself. Get a key from console.anthropic.com -> API Keys. The What If
# chat panel just doesn't render if this is unset.
ANTHROPIC_API_KEY=
